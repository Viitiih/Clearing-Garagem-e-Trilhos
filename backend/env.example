# Copie este arquivo para .env no servidor da API e preencha os dados reais.
# Não suba o .env com senhas para o GitHub.

# Opcional: se precisar do Oracle Instant Client
ORACLE_CLIENT_LIB_DIR=C:\Oracle\instantclient

# Libere o domínio do seu site. Para teste pode usar *, mas em produção use a URL correta.
CORS_ORIGINS=*

AUTOPASS_DSN=host:1521/service
AUTOPASS_USER=usuario
AUTOPASS_PASS=senha

GARAGENS_DSN=host:1521/service
GARAGENS_USER=usuario
GARAGENS_PASS=senha

METRO_DSN=host:1521/service
METRO_USER=usuario
METRO_PASS=senha

CPTM_DSN=host:1521/service
CPTM_USER=usuario
CPTM_PASS=senha
